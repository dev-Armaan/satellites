# Watched environment. Copy to .env.local for development; on Cloudflare, set the same names as the Worker's
# build variables and variables (docs/SELF-HOSTING.md says which goes where).
#
# Supabase (RPC-only access; see supabase/migrations). Use the PUBLISHABLE key (sb_publishable_…),
# never a secret/service_role key: it ships to every browser. Leave both empty to run without a
# backend: lookups, shares and stats then no-op gracefully. See docs/SELF-HOSTING.md.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Optional, server-side only (api/*): canonical origin for absolute og:image / canonical URLs, e.g.
# https://watched.example.com. Defaults to the request's own origin.
SITE_URL=

# Optional, build time: the site's origin, for the canonical links, link-preview tags and sitemap. Defaults to
# https://www.watched.earth, so a fork should set its own.
VITE_SITE_ORIGIN=
