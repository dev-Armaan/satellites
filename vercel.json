{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/og.tsx": {
      "maxDuration": 20,
      "includeFiles": "{api/_fonts/**,api/_assets/**,node_modules/harfbuzzjs/hb.wasm}"
    },
    "api/s.ts": {
      "maxDuration": 10
    },
    "api/e.ts": {
      "maxDuration": 5
    },
    "api/pan.ts": {
      "maxDuration": 20
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
      },
      "continue": true
    },
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/places/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/textures/(.*)", "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" }, "continue": true },
    { "src": "/data/catalog\\.json", "headers": { "Cache-Control": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400" }, "continue": true },
    { "src": "/data/catalog-names\\.json", "headers": { "Cache-Control": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400" }, "continue": true },
    { "src": "/og-default\\.png", "headers": { "Cache-Control": "public, max-age=86400, s-maxage=604800" }, "continue": true },
    {
      "src": "/",
      "has": [
        { "type": "query", "key": "q" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Facebot|Slackbot|Discordbot|LinkedInBot|WhatsApp|TelegramBot|Applebot|redditbot|Bluesky|Mastodon|SkypeUriPreview|Embedly|Pinterestbot|vkShare).*"
        }
      ],
      "dest": "/api/s"
    },
    { "src": "/s/(?<id>[^/]+)", "dest": "/api/s?id=$id" },
    {
      "src": "/admin(?:\\.html)?/?",
      "dest": "/admin.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow", "X-Frame-Options": "DENY", "Cache-Control": "no-cache" }
    },
    { "handle": "filesystem" },
    { "src": "/(?!api/|s/)[^.]*", "dest": "/index.html" }
  ]
}
