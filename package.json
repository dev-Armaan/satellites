{
  "name": "overflight",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build -c vite.admin.config.ts",
    "typecheck": "tsc -b --pretty",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "test": "vitest run",
    "data:celestrak": "tsx scripts/fetch-catalog.ts",
    "textures": "python3 scripts/build-textures.py",
    "test:backend": "vitest run --config scripts/backend-vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@photostructure/tz-lookup": "^11.8.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@resvg/resvg-wasm": "2.4.1",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "2.0.1",
    "fast-png": "8.0.0",
    "geotiff": "^3.0.5",
    "gsap": "^3.15.1",
    "harfbuzzjs": "^0.10.0",
    "jpeg-js": "0.4.4",
    "nanoid": "^6.0.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "satellite.js": "^7.1.0",
    "satori": "0.33.5",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "4.155.0"
  }
}
